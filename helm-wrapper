const HELM_GLOBAL_CACHE_FOLDER = $"($nu.home-dir)/.cache/helm"
const HELM_CHART_FILE = "Chart.yaml"

# Cleanup all the Helm cache directory
def "main cache cleanup" [
    --dry-run # Do not cleanup the cache directories
    --quiet # Do not print the build directories cleaned
]: nothing -> nothing {
    # Global cleanup
    if ($HELM_GLOBAL_CACHE_FOLDER | path exists) {
        if not $quiet {
            print $"Cleaning global directory ($HELM_GLOBAL_CACHE_FOLDER)"
        }
        
        if not $dry_run {
            rm -rf $HELM_GLOBAL_CACHE_FOLDER
        }
    }
}

# Update the Helm chart version
def "main chart version update" [
    --major # Update the major version
    --minor # Update the minor version
    --patch # Update the patch version
    --dry-run # Do not update the version
    --quiet # Do not print the new version
]: nothing -> string {
    let chart_files = glob $"**/($HELM_CHART_FILE)"
    if ($chart_files | length) != 1 {
        print "No or multiple Helm charts found"
        return
    }

    let chart = open --raw $chart_files.0

    # Extract the current version
    let version = $chart
        | parse --regex 'version: (?<version>\d+\.\d+\.\d+)'

    let current_version = ($version.version.0 | into semver)
    let new_version = if $major {
        $current_version | semver bump major
    } else if $minor {
        $current_version | semver bump minor
    } else if $patch {
        $current_version | semver bump patch
    } else {
        $current_version
    }
    if not $dry_run {
        let new_pom = $chart
            | str replace --regex "version: \\d+\\.\\d+\\.\\d+" $"version: ($new_version)"

        $new_pom
            | str trim --right
            | ($in + "\n")
            | save --raw --force $chart_files.0
    }

    if not $quiet {
        print $"New Helm chart version: ($new_version.major).($new_version.minor).($new_version.patch)"
    }

    {
        major: $new_version.major,
        minor: $new_version.minor,
        patch: $new_version.patch
    } | to nuon
}

# Update the Helm chart application version
def "main chart application-version update" [
    --major # Update the major version
    --minor # Update the minor version
    --patch # Update the patch version
    --dry-run # Do not update the version
    --quiet # Do not print the new version
]: nothing -> string {
    let chart_files = glob $"**/($HELM_CHART_FILE)"
    if ($chart_files | length) != 1 {
        print "No or multiple Helm charts found"
        return
    }

    let chart = open --raw $chart_files.0

    # Extract the current version
    let version = $chart
        | parse --regex 'appVersion: "v(?<version>\d+\.\d+\.\d+)"'

    let current_version = ($version.version.0 | into semver)
    let new_version = if $major {
        $current_version | semver bump major
    } else if $minor {
        $current_version | semver bump minor
    } else if $patch {
        $current_version | semver bump patch
    } else {
        $current_version
    }
    if not $dry_run {
        let new_pom = $chart
            | str replace --regex 'appVersion: "v\d+\.\d+\.\d+"' $"appVersion: \"v($new_version)\""

        $new_pom
            | str trim --right
            | ($in + "\n")
            | save --raw --force $chart_files.0
    }

    if not $quiet {
        print $"New Helm chart application version: ($new_version.major).($new_version.minor).($new_version.patch)"
    }

    {
        major: $new_version.major,
        minor: $new_version.minor,
        patch: $new_version.patch
    } | to nuon
}

def main []: nothing -> nothing {}
