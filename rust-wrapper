use mod.nu *
use std

const CARGO_GLOBAL_CACHE_FOLDERS = [
    $"($nu.home-dir)/.cargo/registry/cache"
    $"($nu.home-dir)/.cargo/registry/src"
    $"($nu.home-dir)/.cargo/git/db"
    $"($nu.home-dir)/.cargo/git/checkouts"
]
const RUSTUP_GLOBAL_CACHE_FOLDERS = [
    $"($nu.home-dir)/.rustup/downloads"
    $"($nu.home-dir)/.rustup/tmp"
]
const CARGO_LOCAL_BUILD_FOLDER = "target"
const WASM_LOCAL_BUILD_FOLDER = "dist"
const CARGO_FILE = "Cargo.toml"

# Cleanup all the build directories of the current directory recursively
def "main cache cleanup" [
    --path: string=$GIT_FOLDER # The path to clean
    --dry-run # Do not cleanup the build directories
    --quiet # Do not print the build directories cleaned
]: nothing -> nothing {
    # Global cleanup
    for folder in $CARGO_GLOBAL_CACHE_FOLDERS {
        if ($folder | path exists) {
            if not $quiet {
                print $"Cleaning global directory ($folder)"
            }

            if not $dry_run {
                rm -r $folder
            }
        }
    }
    for folder in $RUSTUP_GLOBAL_CACHE_FOLDERS {
        if ($folder | path exists) {
            if not $quiet {
                print $"Cleaning global directory ($folder)"
            }

            if not $dry_run {
                rm -r $folder
            }
        }
    }

    # Local cleanup
    let local_directories = glob $"($path)/**/{($CARGO_LOCAL_BUILD_FOLDER),($WASM_LOCAL_BUILD_FOLDER)}"

    for local_directory in $local_directories {
        # Skip the directory if it is not part of a direct parent directory
        # (i.e. it is not a Cargo project)
        if not ($"($local_directory)/../($CARGO_FILE)" | path exists) {
            continue
        }

        if not $quiet {
            print $"Cleaning the directory ($local_directory)"
        }

        if $dry_run {
            continue
        }

        rm -r $local_directory
    }
}

# Update the cargo version of the current directory
def "main cargo version update" [
    --major # Update the major version
    --minor # Update the minor version
    --patch # Update the patch version
    --dry-run # Do not update the version
    --quiet # Do not print the new version
]: nothing -> string {
    let cargo = open --raw $CARGO_FILE

    # Extract the package name and current version
    let package_name = $cargo
        | parse --regex 'name\s*=\s*"(?<name>[^"]+)"'
    let package_version = $cargo
        | parse --regex 'version\s*=\s*"(?<version>\d+\.\d+\.\d+)"'

    let project_name = $package_name.name.0
    let current_version = ($package_version.version.0 | into semver)
    let new_version = if $major {
        $current_version | semver bump major
    } else if $minor {
        $current_version | semver bump minor
    } else if $patch {
        $current_version | semver bump patch
    } else {
        $current_version
    }
    if not $dry_run {
        let new_cargo = $cargo
            | str replace --regex 'version\s*=\s*"\d+\.\d+\.\d+"' $'version = "($new_version)"'

        $new_cargo
            | str trim --right
            | ($in + "\n")
            | save --raw --force $CARGO_FILE

        # Update only the current package in Cargo.lock
        ^cargo update --workspace --package ($project_name) out+err> (std null-device)
    }

    if not $quiet {
        print $"New Cargo version: ($new_version.major).($new_version.minor).($new_version.patch)"
    }

    {
        major: $new_version.major,
        minor: $new_version.minor,
        patch: $new_version.patch
    } | to nuon
}

def main []: nothing -> nothing {}
