def build-default-exclusions [enabled: bool]: nothing -> list<string> {
    if not $enabled { return [] }
    let packages_dir = ($GIT_FOLDER | path join "brioche-dev" "brioche-packages" "packages" | path expand)
    if not ($packages_dir | path exists) {
        die $"Packages directory does not exist: ($packages_dir)"
    }
    log $"Building exclusion list from: ($packages_dir)"
    let packages = ls $packages_dir | get name | path basename
    if ($packages | is-empty) {
        log $"No existing packages found in ($packages_dir)"
        return []
    }
    log $"Found ($packages | length) existing packages to exclude"
    $packages
}

def run-source [source: string, limit: int, exclusions: list<string>]: nothing -> list<record> {
    match $source {
        "homebrew" => (fetch-homebrew $limit $exclusions)
        "nixpkgs" => (fetch-nixpkgs $limit $exclusions)
        "arch" => (fetch-arch $limit $exclusions)
        _ => []
    }
}

def merge-package-records [records: list<record>]: nothing -> record {
    $records | reduce {|record|
        let merged = $in
        let recipes = $record.recipes
            | transpose source recipe
            | where {|entry| $entry.recipe != null and not ($entry.recipe | is-empty) }
            | reduce --fold $merged.recipes {|entry, recipes|
                let existing = $recipes | get $entry.source
                if ($existing == null or ($existing | is-empty)) {
                    $recipes | upsert $entry.source $entry.recipe
                } else {
                    $recipes
                }
            }
        $merged | upsert recipes $recipes
    }
}

def merge-packages [packages: list<record>]: nothing -> list<record> {
    $packages
    | group-by name
    | values
    | each {|records| merge-package-records $records }
}

def enrich-package-recipes [package: record]: nothing -> record {
    let recipes = [homebrew nixpkgs arch]
        | where {|source|
            let recipe = $package.recipes | get $source
            $recipe == null or ($recipe | is-empty)
        }
        | each {|source|
            let recipe = try {
                match $source {
                    homebrew => (fetch-homebrew-info $package.name)
                    nixpkgs => (fetch-nixpkgs-info $package.name)
                    arch => (fetch-arch-info $package.name)
                }
            } catch { {} }
            {source: $source recipe: $recipe}
        }
        | where {|entry| not ($entry.recipe | is-empty) }
        | reduce --fold $package.recipes {|entry, recipes|
            $recipes | upsert $entry.source $entry.recipe
        }
    $package | upsert recipes $recipes
}

const LIVE_UPDATE_PR_FIELDS = "number,title,body,author,state,isDraft,url,headRefName,baseRefName,headRefOid,baseRefOid,reviewDecision,mergeStateStatus,mergeable,statusCheckRollup,updatedAt,labels"

# Capture GitHub CLI output so failures stay outside the TUI.
def capture-gh [args: list<string>, cwd: path]: nothing -> record {
    let result = try {
        do -i {
            cd $cwd
            ^gh ...$args | complete
        }
    } catch {|error|
        {
            stdout: ""
            stderr: ($error.msg? | default ($error | into string))
            exit_code: 1
        }
    }
    {
        stdout: ($result.stdout? | default "")
        stderr: ($result.stderr? | default "")
        exit_code: ($result.exit_code? | default 1)
    }
}

def command-error [result: record]: nothing -> string {
    let detail = [$result.stderr? $result.stdout?] | where {|part| $part != null and not ($part | is-empty) } | str join "\n" | str trim
    if ($detail | str length) > 2000 {
        $detail | str substring 0..2000
    } else {
        $detail
    }
}

def run-gh-json [args: list<string>, cwd: path]: nothing -> record {
    let result = capture-gh $args $cwd
    if $result.exit_code != 0 {
        return {ok: false data: null error: ((command-error $result) | default $"gh exited with code ($result.exit_code)")}
    }
    try {
        {ok: true data: ($result.stdout | from json) error: ""}
    } catch {|error|
        {ok: false data: null error: ($error.msg? | default "GitHub returned invalid JSON.")}
    }
}

def package-update-author [login: string]: nothing -> bool {
    $login in [package-update-bot[bot] package-update-bot app/package-update-bot]
}

def has-live-update-label [pull_request: record]: nothing -> bool {
    ($pull_request.labels? | default [] | any {|label| ($label.name? | default "") == "live update" })
}

def eligible-live-update [pull_request: record]: nothing -> bool {
    let author = $pull_request.author.login? | default ""
    let title = $pull_request.title? | default "" | str lowercase
    let is_open = ($pull_request.state? | default "" | str uppercase) == "OPEN"
    let is_draft = $pull_request.isDraft? | default false
    let is_bot = package-update-author $author
    let has_title = ($title | str replace --regex '\blive update\b' "") != $title
    let has_label = has-live-update-label $pull_request
    ($is_open and not $is_draft and $is_bot and $has_title and $has_label)
}

def live-update-pull-requests []: nothing -> record {
    let checkout = $GIT_FOLDER | path join $BRIOCHE_REPOSITORY
    let listed = run-gh-json [
        "pr" "list" "--repo" $BRIOCHE_REPOSITORY "--state" "open" "-L" "100"
        "--app" "package-update-bot" "--label" "live update" "--search" "review:none"
        "--json" "number,title,updatedAt"
    ] $checkout
    if not $listed.ok {
        return {ok: false pull_requests: [] warnings: [$"Could not list Brioche live-update PRs: ($listed.error)"] metadata_errors: 0}
    }

    mut pull_requests = []
    mut warnings = []
    mut metadata_errors = 0
    for summary in $listed.data {
        let number = $summary.number? | default null
        if $number == null { continue }
        let viewed = run-gh-json [
            "pr" "view" ($number | into string) "--repo" $BRIOCHE_REPOSITORY "--json" $LIVE_UPDATE_PR_FIELDS
        ] $checkout
        if not $viewed.ok {
            $metadata_errors += 1
            if $metadata_errors <= 5 {
                $warnings = ($warnings | append $"Could not load PR ($number): ($viewed.error)")
            }
            continue
        }
        let pull_request = $viewed.data | insert repository $BRIOCHE_REPOSITORY
        if not (eligible-live-update $pull_request) { continue }
        if ($pull_request.headRefOid? | default "" | is-empty) or ($pull_request.baseRefOid? | default "" | is-empty) {
            $metadata_errors += 1
            if $metadata_errors <= 5 {
                $warnings = ($warnings | append $"PR ($number) has no stable head or base revision and was not added.")
            }
            continue
        }
        $pull_requests = ($pull_requests | append $pull_request)
    }
    if $metadata_errors > 5 {
        $warnings = ($warnings | append $"($metadata_errors - 5) additional PR metadata errors were omitted.")
    }
    {
        ok: true
        pull_requests: ($pull_requests | sort-by updatedAt -r)
        warnings: $warnings
        metadata_errors: $metadata_errors
    }
}

def live-update-check-summary [checks: list<record>]: nothing -> string {
    if ($checks | is-empty) {
        "no checks"
    } else {
        let states = $checks | each {|check|
            ($check.conclusion? | default ($check.status? | default ($check.state? | default ""))) | str uppercase
        }
        if ($states | any {|state| $state in [FAILURE ERROR FAIL CANCELLED ACTION_REQUIRED TIMED_OUT STALE]}) {
            "failure"
        } else if ($states | any {|state| $state in [PENDING EXPECTED QUEUED IN_PROGRESS WAITING REQUESTED COMPLETED ""]}) {
            "pending"
        } else {
            "success"
        }
    }
}

def live-update-metadata [pull_request: record]: nothing -> record {
    let merge_state = ($pull_request.mergeStateStatus? | default $pull_request.mergeable? | default "unknown" | str uppercase)
    let status = if $merge_state in [CLEAN MERGEABLE] {
        "ready to merge"
    } else if $merge_state in [DIRTY CONFLICTING] {
        "merge conflict"
    } else {
        ($pull_request.state? | default "unknown" | str lowercase)
    }
    let review = match ($pull_request.reviewDecision? | default "" | str uppercase) {
        "APPROVED" => "approved"
        "CHANGES_REQUESTED" => "changes requested"
        "REVIEW_REQUIRED" => "review required"
        _ => "not requested"
    }
    let author = $pull_request.author.login? | default "unknown"
    let draft = if ($pull_request.isDraft? | default false) { "[draft] " } else { "" }
    let checks = $pull_request.statusCheckRollup? | default []
    {
        identity: $"PR Detail | #($pull_request.number) | ($pull_request.repository)"
        title: $"($draft)($pull_request.title)"
        author: $"Author: ($author)"
        status: $"Status: ($status)"
        checks: $"Checks: (live-update-check-summary $checks)"
        review: $"Review: ($review)"
        branches: $"Branches: ($pull_request.headRefName) to ($pull_request.baseRefName)"
        url: $"URL: ($pull_request.url)"
    }
}

def live-update-diff-cache-file [pull_request: record]: nothing -> path {
    let cache_dir = $nu.cache-dir | path join "brioche-wrapper" "live-update-diffs"
    let repository_key = $pull_request.repository | str replace --all "/" "_"
    $cache_dir | path join $"($repository_key)-($pull_request.number)-($pull_request.headRefOid)-($pull_request.baseRefOid).diff"
}

def safe-package-recipe [recipe: string]: nothing -> bool {
    let parts = $recipe | path split
    if ($parts | is-empty) { return false }
    $parts | all {|part|
        $part not-in ["" "." ".."] and (($part | str replace --regex '^[A-Za-z0-9._+\-]+$' "") | is-empty)
    }
}

def validate-live-update-diff [diff: string]: nothing -> record {
    let changed = $diff
        | lines
        | where {|line| $line | str starts-with "diff --git " }
        | each {|line|
            let parsed = $line | parse --regex '^diff --git a/(?<old>.+) b/(?<new>.+)$'
            if ($parsed | is-empty) {
                {old: "", new: ""}
            } else {
                $parsed | first
            }
        }
    if ($changed | is-empty) {
        return {ok: false recipe: "" error: "The pull request diff has no changed recipe files."}
    }
    let recipe_files = $changed | each {|entry|
        let parsed = $entry.new | parse --regex '^packages/(?<recipe>.+)/(?<file>project\.bri|brioche\.lock)$'
        if ($parsed | is-empty) or $entry.old != $entry.new {
            null
        } else {
            $parsed | first
        }
    } | compact
    if ($recipe_files | length) != ($changed | length) {
        return {ok: false recipe: "" error: "The PR must update only project.bri and/or brioche.lock for one package recipe."}
    }
    let recipes = $recipe_files | get recipe | uniq
    if ($recipes | length) != 1 {
        return {ok: false recipe: "" error: "The PR must update only one package recipe."}
    }
    let recipe = $recipes | first
    if not (safe-package-recipe $recipe) {
        return {ok: false recipe: "" error: "The PR contains an unsafe package recipe path."}
    }
    {ok: true recipe: $recipe error: ""}
}

def fetch-live-update-diff [pull_request: record]: nothing -> record {
    let result = capture-gh [
        "pr" "diff" ($pull_request.number | into string) "--repo" $pull_request.repository
    ] ($GIT_FOLDER | path join $pull_request.repository)
    if $result.exit_code != 0 {
        return {ok: false diff: "" recipe: "" error: ((command-error $result) | default $"gh pr diff exited with code ($result.exit_code)")}
    }
    let validation = validate-live-update-diff $result.stdout
    if not $validation.ok {
        return {ok: false diff: $result.stdout recipe: "" error: $validation.error}
    }
    let cache_file = live-update-diff-cache-file $pull_request
    mkdir ($cache_file | path dirname) | ignore
    $result.stdout | save --force $cache_file
    {ok: true diff: $result.stdout recipe: $validation.recipe error: ""}
}

def live-update-raw-diff [pull_request: record]: nothing -> record {
    let cache_file = live-update-diff-cache-file $pull_request
    if ($cache_file | path exists) {
        let cached = try {
            {ok: true diff: (open --raw $cache_file) error: ""}
        } catch {|error|
            {ok: false diff: "" error: ($error.msg? | default "Could not read cached diff.")}
        }
        if $cached.ok {
            let validation = validate-live-update-diff $cached.diff
            if $validation.ok {
                return {ok: true diff: $cached.diff recipe: $validation.recipe error: ""}
            }
        }
    }
    fetch-live-update-diff $pull_request
}

def live-update-diff-lines [pull_request: record]: nothing -> list<string> {
    let raw_diff = live-update-raw-diff $pull_request
    if not $raw_diff.ok {
        return $raw_diff.error | lines
    }
    let rendered = try {
        do -i { $raw_diff.diff | ^delta --color-only --paging=never --detect-dark-light=never | complete }
    } catch {
        {stdout: "" exit_code: 1}
    }
    if ($rendered.exit_code? | default 1) == 0 {
        $rendered.stdout | lines
    } else {
        $raw_diff.diff | lines
    }
}

def live-update-pr-table [pull_requests: list<record>]: nothing -> record {
    $pull_requests
    | tui label --titlebar "Brioche live-update pull requests"
    | tui split --sizes [34% 1fr] [
        (tui split --vertical --sizes [1fr 10] [
            (tui box "Pull requests" [
                (tui search --placeholder "Filter title or branch" --bind / --fuzzy --columns [title headRefName])
                (tui table --id pull-requests --focus --columns [title headRefName])
            ])
            (tui box "PR metadata" [
                (tui label --from pull-requests {|pr| live-update-metadata $pr | get identity })
                (tui label --from pull-requests {|pr| live-update-metadata $pr | get title })
                (tui label --from pull-requests {|pr| live-update-metadata $pr | get author })
                (tui label --from pull-requests {|pr| live-update-metadata $pr | get status })
                (tui label --from pull-requests {|pr| live-update-metadata $pr | get checks })
                (tui label --from pull-requests {|pr| live-update-metadata $pr | get review })
                (tui label --from pull-requests {|pr| live-update-metadata $pr | get branches })
                (tui label --from pull-requests {|pr| live-update-metadata $pr | get url })
            ])
        ])
        (tui log --id pr-diff --title "Diff" --from pull-requests --max-lines 100000 {|pull_request|
            live-update-diff-lines $pull_request
        })
    ]
    | tui label --status "/: filter  tab: switch panel  up/down: move or scroll  enter: choose action  q: quit"
    | tui run
}

