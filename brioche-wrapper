use mod.nu *

const BRIOCHE_REPOSITORY = "brioche-dev/brioche-packages"
const DEFAULT_DISCOVER_LIMIT = "30"

use ./misc/brioche-helpers/mod.nu [set-quiet log die parse-limit parse-exclusions]
use ./misc/brioche-helpers/homebrew.nu [fetch-homebrew]
use ./misc/brioche-helpers/nixpkgs.nu [fetch-nixpkgs]
use ./misc/brioche-helpers/arch.nu [fetch-arch]
use ./misc/brioche-helpers/build-type-lookup.nu [fetch-homebrew-info fetch-nixpkgs-info fetch-arch-info]

def build-default-exclusions [enabled: bool]: nothing -> list<string> {
    if not $enabled { return [] }
    let packages_dir = ($GIT_FOLDER | path join "brioche-dev" "brioche-packages" "packages" | path expand)
    if not ($packages_dir | path exists) {
        die $"Packages directory does not exist: ($packages_dir)"
    }
    log $"Building exclusion list from: ($packages_dir)"
    let packages = ls $packages_dir | get name | path basename
    if ($packages | is-empty) {
        log $"No existing packages found in ($packages_dir)"
        return []
    }
    log $"Found ($packages | length) existing packages to exclude"
    $packages
}

def run-source [source: string, limit: int, exclusions: list<string>]: nothing -> list<record> {
    match $source {
        "homebrew" => (fetch-homebrew $limit $exclusions)
        "nixpkgs" => (fetch-nixpkgs $limit $exclusions)
        "arch" => (fetch-arch $limit $exclusions)
        _ => []
    }
}

def merge-package-records [records: list<record>]: nothing -> record {
    $records | reduce {|record|
        let merged = $in
        let recipes = $record.recipes
            | transpose source recipe
            | where {|entry| $entry.recipe != null and not ($entry.recipe | is-empty) }
            | reduce --fold $merged.recipes {|entry, recipes|
                let existing = $recipes | get $entry.source
                if ($existing == null or ($existing | is-empty)) {
                    $recipes | upsert $entry.source $entry.recipe
                } else {
                    $recipes
                }
            }
        $merged | upsert recipes $recipes
    }
}

def merge-packages [packages: list<record>]: nothing -> list<record> {
    $packages
    | group-by name
    | values
    | each {|records| merge-package-records $records }
}

def enrich-package-recipes [package: record]: nothing -> record {
    let recipes = [homebrew nixpkgs arch]
        | where {|source|
            let recipe = $package.recipes | get $source
            $recipe == null or ($recipe | is-empty)
        }
        | each {|source|
            let recipe = try {
                match $source {
                    homebrew => (fetch-homebrew-info $package.name)
                    nixpkgs => (fetch-nixpkgs-info $package.name)
                    arch => (fetch-arch-info $package.name)
                }
            } catch { {} }
            {source: $source recipe: $recipe}
        }
        | where {|entry| not ($entry.recipe | is-empty) }
        | reduce --fold $package.recipes {|entry, recipes|
            $recipes | upsert $entry.source $entry.recipe
        }
    $package | upsert recipes $recipes
}

# List all the live update PRs, and review them one by one
def "main live-update review" []: nothing -> nothing {
    print "Starting live-update PRs review..."

    let pull_requests = ^gh pr --repo $BRIOCHE_REPOSITORY list -L 100 -l "live update" --search "review:none" --json number | from json
    for pull_request in $pull_requests {
        print $"\nDiffing from PR ($pull_request.number):"
        ^gh pr --repo $BRIOCHE_REPOSITORY diff $pull_request.number

        let result = input "Approve the PR and enable auto-merge [y/N]: "
        if ($result == "y") {
            ^gh pr --repo $BRIOCHE_REPOSITORY edit --add-assignee @me $pull_request.number
            ^gh pr --repo $BRIOCHE_REPOSITORY review --approve --body "Looks good to me 🚀" $pull_request.number
            ^gh pr --repo $BRIOCHE_REPOSITORY merge --auto $pull_request.number
        } else {
            let result = input "Checkout the PR locally [y/N]: "
            if ($result == "y") {
                cd $"($GIT_FOLDER)/($BRIOCHE_REPOSITORY)"
                ^gh pr --repo $BRIOCHE_REPOSITORY checkout $pull_request.number

                exit
            }
        }
    }
}

# Discover recently updated packages from supported package managers.
def "main packages discover" [
    --source (-s): string = "all"
    --limit (-l): string = $DEFAULT_DISCOVER_LIMIT
    --exclude: string = ""
    --exclude-defaults
    --quiet (-q)
]: nothing -> string {
    if $source not-in [homebrew nixpkgs arch all] {
        die $"Invalid source: ($source), must be homebrew, nixpkgs, arch, or all"
    }
    let parsed_limit = parse-limit $limit
    set-quiet $quiet

    let default_exclusions = build-default-exclusions $exclude_defaults
    let manual_exclusions = parse-exclusions $exclude
    let exclusions = $default_exclusions ++ $manual_exclusions
    let sources = if $source == "all" {
        [homebrew nixpkgs arch]
    } else {
        [$source]
    }
    let source_limit = if $source == "all" {
        [($parsed_limit // 2) 1] | math max
    } else {
        $parsed_limit
    }
    log $"Starting package discovery, source=($source), limit=($parsed_limit), per-source-limit=($source_limit)"

    let attempts = $sources
        | par-each {|source_name|
            log $"Running ($source_name) fetcher..."
            try {
                {
                    ok: true
                    source: $source_name
                    packages: (run-source $source_name $source_limit $exclusions)
                }
            } catch {|error|
                let message = $error.msg? | default ($error.rendered? | default "unknown error")
                log $"WARNING: ($source_name) fetcher failed: ($message)"
                {
                    ok: false
                    source: $source_name
                    packages: []
                    error: $message
                }
            }
        }
    let packages = $attempts
        | where ok
        | get packages
        | flatten
    let failed = $attempts
        | where {|attempt| not $attempt.ok }
        | reduce --fold {} {|attempt, failed|
            let message = $attempt.error? | default "unknown error"
            $failed | upsert $attempt.source [$message]
        }

    let total_found = $packages | length
    let deduplicated = merge-packages $packages
    let enriched = $deduplicated | par-each --keep-order --threads 2 {|package| enrich-package-recipes $package }
    let timestamp = date now | format date "%Y-%m-%dT%H:%M:%SZ"
    log $"Discovery complete: ($enriched | length) packages after filtering"
    {
        packages: $enriched
        metadata: {
            total_found: $total_found
            after_filtering: ($enriched | length)
            excluded_count: ($default_exclusions | length)
            sources_checked: $sources
            failed: $failed
            timestamp: $timestamp
        }
    } | to json --raw
}

def main []: nothing -> nothing {}
